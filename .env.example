DATABASE_URL=
# db | json. Si se deja vacío o sin definir, se usa json.
DATA_SOURCE=json
NEXT_PUBLIC_COMMERCE_ENABLED=false
NEXT_PUBLIC_GTM_ID=GTM-WQCFFJMD
NEXT_PUBLIC_SITE_URL=https://sediemobili.com
# console | db | resend. Si se deja vacío o sin definir, se usa console (desarrollo: no manda nada).
# resend avisa por correo a ventas y manda los suscriptores del newsletter a los contactos de Resend.
LEADS_SINK=console
# Clave de la API de Resend (cuenta de Sedie). Solo hace falta con LEADS_SINK=resend.
RESEND_API_KEY=
# Opcional: segmento de Resend (antes "audiencia") al que entran los suscriptores del newsletter.
# Sin definir, el suscriptor queda solo en los contactos de Resend.
RESEND_SEGMENT_ID=
# Clave de la API de catálogo de Sedie (solo lectura). La usa pnpm sync:catalogo; el sitio todavía no.
SEDIE_API_KEY=
